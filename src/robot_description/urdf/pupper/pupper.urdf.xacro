  <xacro:frame_joint name="f_l_Coax_servo_Coax" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_Coax_servo" child="front_left_Coax"/>  
                  
  <xacro:mesh_link name="front_left_shlouder"
              origin_rpy="0 0 0" origin_xyz="-0.15493 -0.03768 -0.019101"
              i_rpy="0 0 0" i_xyz="-0.020287 0.058053 0.022614"
              mass="0.02"
              c_xyz="-0.020287 0.05327 0.007516"
              length="0.025"
              width="0.073"
              height="0.0609"
              matname="orange"
