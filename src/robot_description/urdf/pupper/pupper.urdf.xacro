  <xacro:frame_joint name="f_l_thigh_servo_rudder" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_thigh_Servo" child="front_left_thigh_rudder"/> 
                  
  <xacro:mesh_link name="front_left_thigh"
              origin_rpy="0 0 0" origin_xyz="-0.135449 -0.07015 -0.00883"
              i_rpy="0 0 0" i_xyz="-0.01291 0.032152 -0.034725"
              mass="0.06"
