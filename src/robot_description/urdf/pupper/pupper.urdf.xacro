  <xacro:frame_joint name="f_l_leg_servo_rudder" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_thigh" child="front_left_leg_rudder"/>
                  
  <xacro:mesh_link name="front_left_leg_Servo"
              origin_rpy="0 0 0" origin_xyz="-0.108069 -0.073783 0.076816"
              i_rpy="0 0 0" i_xyz="0 0.02386 -0.020465"
