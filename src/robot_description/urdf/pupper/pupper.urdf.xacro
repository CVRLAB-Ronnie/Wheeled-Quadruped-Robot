              matname="red"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/BackShoulderInner.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
  <!-- mass="0.03" -->            
  <xacro:mesh_link_body name="back_shoulder_outer"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="-0.157649 0.000384 0.018141"
