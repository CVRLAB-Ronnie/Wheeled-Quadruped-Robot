              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:frame_joint name="f_l_wheel_leg_servo" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_leg" child="front_left_wheel_Servo"/>
                  
  <xacro:mesh_link name="front_left_wheel_rudder"
              origin_rpy="0 0 0" origin_xyz="-0.108069 -0.073783 0.076816"
              i_rpy="0 0 0" i_xyz="0.001893 0.017314 -0.119183"
              mass="0.005"
              c_xyz="${-0.247} ${-0.068} ${0.18}"
              length="0.02"
