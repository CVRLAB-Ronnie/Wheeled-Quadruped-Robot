                    effort="${effort_limit}" velocity="${velocity_limit}"
                    damping="${damping_value}"
                    friction="${friction_value}"
                    lower="-2.9"
                    upper="${pi/2}"/>
     
  <xacro:mesh_link name="front_left_leg"
              origin_rpy="0 0 0" origin_xyz="-0.108069 -0.073783 0.076816"
              i_rpy="0 0 0" i_xyz="-0.002639 0.034269 -0.053288"
              mass="0.066"
