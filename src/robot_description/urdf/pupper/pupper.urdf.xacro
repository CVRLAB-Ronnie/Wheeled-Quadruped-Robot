<!-- STATIC Joints -->
<!-- FOOTPRINT TO MAIN BODY-->
<xacro:frame_joint name="base_base" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="base_inertia"/>
<!-- MAIN BODY TO BATTERY -->
<xacro:frame_joint name="base_cover_b" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="bottom_cover"/>
<!-- MAIN BODY TO CHASSIS LEFT -->
<xacro:frame_joint name="base_cover_t" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="top_cover"/>
<!-- MAIN BODY TO CHASSIS RIGHT -->
<xacro:frame_joint name="base_cover_bh" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="BottomHatch"/>
<!-- MAIN BODY TO FRONT -->
<xacro:frame_joint name="base_front_si" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="front_shoulder_inner"/>
<!-- MAIN BODY TO BACK -->
<xacro:frame_joint name="base_front_so" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="front_shoulder_outer"/>
<!-- MAIN BODY TO FRONT BRACKET -->
<xacro:frame_joint name="base_back_si" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="back_shoulder_inner"/>
<!-- MAIN BODY TO BACK BRACKET -->
<xacro:frame_joint name="base_back_so" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="back_shoulder_outer"/>
<xacro:frame_joint name="base_head" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="head"/>
<xacro:frame_joint name="base_head_camera" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="head_camera"/>
<xacro:frame_joint name="base_RP_B" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="RearPanel_Base"/>
<xacro:frame_joint name="base_RP_S" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="RearPanel_Shell"/>
<xacro:frame_joint name="base_raspi_T" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="raspi_Top"/>
<xacro:frame_joint name="base_raspi_B" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="raspi_Bottom"/>
<xacro:frame_joint name="base_raspi" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="base_link" child="RASPBERRY_PI_4B"/>
 
<ros2_control name="GazeboSystem" type="system">   
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>    
    <xacro:quadruped_transmission leg="front_left"/>
    <xacro:quadruped_transmission leg="front_right"/>
    <xacro:quadruped_transmission leg="back_left"/>
    <xacro:quadruped_transmission leg="back_right"/>  

</ros2_control> 
<gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <robot_sim_type>gazebo_ros2_control/GazeboSystem</robot_sim_type>
        <parameters>$(find robot_description)/config/pupper_control_effort.yaml</parameters>
        <robot_param_node>/robot_state_publisher</robot_param_node>
      </plugin>
</gazebo>

<!-- RL4 friction -->
  <gazebo reference="back_left_wheel">
    <sensor name="my_contact" type="contact">
          <plugin name="my_plugin" filename="libmy_ContactPlugin.so" />
          <contact>
            <collision>back_left_wheel_fixed_joint_lump__collision_collision_1</collision>
          </contact>  
        </sensor>
  </gazebo>

</robot>
