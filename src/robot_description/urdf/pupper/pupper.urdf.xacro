              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:frame_joint name="b_l_Coax_servo_rudder" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="back_left_Coax_servo" child="back_left_Coax_rudder"/>
                  
  <xacro:mesh_link name="back_left_Coax"
              origin_rpy="0 0 0" origin_xyz="0.126857 -0.03768 -0.019101"
              i_rpy="0 0 0" i_xyz="-0.021825 0.013198 -0.008933"
              mass="0.04"
              c_xyz="-0.021825 0.008596 -0.008933"
              length="0.0461"
              width="0.0375"
