              width="0.11"
              height="0.07"
              matname="red"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/BackShoulderOuter.stl"
              meshscale="1 1 1" /> <!-- m to mm -->

  <!-- Head -->
  <xacro:mesh_link_body name="head"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="0.179619 -0.000148 0.013529"
              mass="0.02"
              c_xyz="0 0 0"
              length="0.093"
              width="0.116"
              height="0.0725"
              matname="red"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/head.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:mesh_link_body name="head_camera"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="0.19128 0.000471 0.006541"
              mass="0.03"
              c_xyz="0 0 0"
              length="0.0383"
              width="0.042"
              height="0.0472"
              matname="black"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/head_camera.stl"
              meshscale="1 1 1" /> <!-- m to mm -->            

  <!-- BACK -->
  <xacro:mesh_link_body name="RearPanel_Base"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="-0.200539 0.000216 0.010735"
              mass="0.02"
              c_xyz="0 0 0"
              length="0.0081"
              width="0.0996"
              height="0.061"
              matname="red"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/RearPanel_Base.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
   
  <xacro:mesh_link_body name="RearPanel_Shell"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="-0.180045 -0.000455 0.013589"
              mass="0.05"
              c_xyz="0 0 0"
              length="0.0699"
              width="0.116"
              height="0.0725"
              matname="red"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/RearPanel_Shell.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
  <!-- RASPI -->
  <xacro:mesh_link_body name="raspi_Top"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="0.053321 -0.000404 0.070793"
              mass="0.025"
              c_xyz="0 0 0"
              length="0.0906"
              width="0.0614"
              height="0.0234"
              matname="white"
              meshfile="file://$(find robot_description)/meshes/pupper/raspi/raspi_Top.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:mesh_link_body name="raspi_Bottom"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="0.048989 -0.000236 0.050542"
              mass="0.016"
              c_xyz="0 0 0"
              length="0.0906"
