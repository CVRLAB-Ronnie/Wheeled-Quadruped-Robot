              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:frame_joint name="f_l_wheel_frame_tire" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_wheel" child="front_left_tire"/> 
         
  <!-- BACK LEFT LEG -->
  <!-- Coax -->
  <xacro:mesh_link name="back_left_Coax_servo"
              origin_rpy="0 0 0" origin_xyz="0.126857 -0.03768 -0.019101"
              i_rpy="0 0 0" i_xyz="-0.018837 0 -0.010419"
              mass="0.06"
              c_xyz="-0.018837 0 -0.010419"
              length="0.042"
              width="0.02"
              height="0.0545"
              matname="black"
              meshfile="file://$(find robot_description)/meshes/pupper/leg/back_left/back_left_Coax_Servo.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:rev_joint name="motor_back_left_coax" type="revolute"
                    axis_xyz="1 0 0"
                    origin_rpy="0 0 0" origin_xyz="-0.126857 0.03768 0.019101"
                    parent="back_shoulder_inner" child="back_left_Coax_servo"
                    effort="${effort_limit}" velocity="${velocity_limit}"
                    damping="${damping_value}"
                    friction="${friction_value}"
                    lower="-1.04"
                    upper="1.04"/>
                    
  <xacro:mesh_link name="back_left_Coax_rudder"
              origin_rpy="0 0 0" origin_xyz="0.126857 -0.03768 -0.019101"
              i_rpy="0 0 0" i_xyz="0.003856 0 0"
              mass="0.005"
              c_xyz="0.002883 0 0"
              length="0.0045"
