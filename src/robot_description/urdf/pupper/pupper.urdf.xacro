              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:mesh_link_body name="front_shoulder_outer"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="0.162468 -0.001186 0.009675"
