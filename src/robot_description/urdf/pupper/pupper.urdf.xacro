              height="0.0097"
              matname="black"
              meshfile="file://$(find robot_description)/meshes/pupper/raspi/raspi_Bottom.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
  
  <xacro:mesh_link_body name="RASPBERRY_PI_4B"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="0.036607 0.001066 0.058964"
              mass="0.047"
              c_xyz="0 0 0"
              length="0.0897"
              width="0.0584"
              height="0.0188"
              matname="green"
              meshfile="file://$(find robot_description)/meshes/pupper/raspi/RASPBERRY_PI_4B.stl"
              meshscale="1 1 1" /> <!-- m to mm -->

  <!-- DYNAMIC LINKS (Joints Included) -->
  <!-- FRONT LEFT LEG -->
  <!-- Coax -->
  <xacro:mesh_link name="front_left_Coax_servo"
              origin_rpy="0 0 0" origin_xyz="-0.15493 -0.03768 -0.019101"
              i_rpy="0 0 0" i_xyz="-0.018837 0 -0.010419"
              mass="0.06"
              c_xyz="-0.018837 0 -0.010419"
              length="0.042"
              width="0.02"
              height="0.0545"
              matname="black"
              meshfile="file://$(find robot_description)/meshes/pupper/leg/front_left/front_left_Coax_Servo.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:rev_joint name="motor_front_left_coax" type="revolute"
                    axis_xyz="1 0 0"
                    origin_rpy="0 0 0" origin_xyz="0.15493 0.03768 0.019101"
                    parent="front_shoulder_outer" child="front_left_Coax_servo"
                    effort="${effort_limit}" velocity="${velocity_limit}"
                    damping="${damping_value}"
                    friction="${friction_value}"
                    lower="-1.04"
                    upper="1.04"/>
                    
  <xacro:mesh_link name="front_left_Coax_rudder"
              origin_rpy="0 0 0" origin_xyz="-0.15493 -0.03768 -0.019101"
              i_rpy="0 0 0" i_xyz="0.003856 0 0"
              mass="0.005"
              c_xyz="0.002883 0 0"
              length="0.0045"
              width="0.02"
              height="0.02"
              matname="black"
              meshfile="file://$(find robot_description)/meshes/pupper/leg/front_left/front_left_Coax_rudder.stl"
              meshscale="1 1 1" /> <!-- m to mm -->

  <xacro:frame_joint name="f_l_Coax_servo_rudder" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_Coax_servo" child="front_left_Coax_rudder"/>
                  
  <xacro:mesh_link name="front_left_Coax"
              origin_rpy="0 0 0" origin_xyz="-0.15493 -0.03768 -0.019101"
