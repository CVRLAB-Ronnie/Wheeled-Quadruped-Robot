  <xacro:frame_joint name="f_l_thigh_servo_thigh" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_thigh_Servo" child="front_left_thigh"/> 
                                      
  <!-- LOWER LEG -->
  <xacro:mesh_link name="front_left_leg_rudder"
              origin_rpy="0 0 0" origin_xyz="-0.135449 -0.07015 -0.00883"
              i_rpy="0 0 0" i_xyz="-0.028336 -0.003934 -0.075276"
