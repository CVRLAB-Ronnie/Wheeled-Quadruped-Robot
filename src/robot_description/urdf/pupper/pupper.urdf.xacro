              c_xyz="0 0 0"
              length="0.213"
              width="0.107"
              height="0.0221"
              matname="white"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/BottomHatch.stl"
              meshscale="1 1 1" /> <!-- m to mm -->

  <!-- FrontShoulder -->
  <xacro:mesh_link_body name="front_shoulder_inner"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
