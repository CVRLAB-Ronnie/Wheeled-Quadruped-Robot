              c_xyz="0 0 0"
              length="0.006"
              width="0.11"
              height="0.066"
              matname="red"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/FrontShoulderOuter.stl"
              meshscale="1 1 1" /> <!-- m to mm -->

  <!-- BackShoulder -->
  <xacro:mesh_link_body name="back_shoulder_inner"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="-0.11978 0.000675 0.009675"
