  <xacro:frame_joint name="f_l_Coax_Shlouder" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_Coax" child="front_left_shlouder"/>  
                  
  <!-- UPPER LEG -->
  <xacro:mesh_link name="front_left_thigh_Servo"
              origin_rpy="0 0 0" origin_xyz="-0.135449 -0.07015 -0.00883"
              i_rpy="0 0 0" i_xyz="-0.0055 0.018242 -0.008867"
              mass="0.06"
              c_xyz="-0.0055 0.018242 -0.008867"
              length="0.0458"
              width="0.042"
              height="0.0568"
              matname="black"
              meshfile="file://$(find robot_description)/meshes/pupper/leg/front_left/front_left_thigh_Servo.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:rev_joint name="motor_front_left_thigh" type="revolute"
                    axis_xyz="0 1 0"
                    origin_rpy="0 0 0" origin_xyz="-0.019498 0.032469 -0.010262"
                    parent="front_left_Coax" child="front_left_thigh_Servo"
                    effort="${effort_limit}" velocity="${velocity_limit}"
                    damping="${damping_value}"
                    friction="${friction_value}"
                    lower="${-pi/2}"
                    upper="2.59"/>
                    
  <xacro:mesh_link name="front_left_thigh_rudder"
              origin_rpy="0 0 0" origin_xyz="-0.135449 -0.07015 -0.00883"
              i_rpy="0 0 0" i_xyz="0 -0.004899 0"
              mass="0.005"
              c_xyz="0 -0.003926 0"
              length="0.02"
              width="0.0045"
              height="0.02"
              matname="black"
              meshfile="file://$(find robot_description)/meshes/pupper/leg/front_left/front_left_thigh_rudder.stl"
