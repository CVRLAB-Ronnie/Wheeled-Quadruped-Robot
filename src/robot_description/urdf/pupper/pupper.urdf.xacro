<?xml version="1.0"?>
<robot name="pupper" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="damping_value" value="0.01" />
  <xacro:property name="friction_value" value="1" />
  <xacro:property name="effort_limit" value="4" />
  <xacro:property name="velocity_limit" value="4" />
  <xacro:property name="wheel_damping_value" value="0.001" />
  <xacro:property name="wheel_friction_value" value="0.08" />
  <!-- Include Macros -->
  <xacro:include filename="$(find robot_description)/urdf/pupper/pupper_macro.xacro" />
  <xacro:include filename="$(find robot_description)/urdf/pupper/transmissions.xacro" />
  <xacro:include filename="$(find robot_description)/urdf/pupper/accessories.urdf.xacro" /> 
  <!--<link name="world"/>
  <gazebo reference="world">
    <static>true</static>
    
  </gazebo>
  <joint name="world_to_base" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.24"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>-->
  
  <!-- Robot description -->
  <!-- STATIC Links -->
  <link name="base_link"/>

  <!-- MAIN BODY -->
  <xacro:mesh_link_body name="base_inertia"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="0 0 0"
              mass="0.001"
              c_xyz="0 0 0"
              length="0.224"
              width="0.11"
              height="0.0701"
              matname="white"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/body.stl"
              meshscale="1 1 1" /> <!-- m to mm -->

  <xacro:mesh_link_body name="bottom_cover"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="-0.008053 -0.000153 -0.025779"
              mass="0.05"
              c_xyz="0 0 0"
              length="0.277"
              width="0.114"
              height="0.0485"
              matname="red"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/bottom_cover.stl"
              meshscale="1 1 1" /> <!-- m to mm -->

  <xacro:mesh_link_body name="top_cover"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
              i_rpy="0 0 0" i_xyz="-0.002497 0.000255 0.040206"
              mass="0.05"
              c_xyz="0 0 0"
              length="0.277"
              width="0.119"
              height="0.0446"
              matname="red"
              meshfile="file://$(find robot_description)/meshes/pupper/main_body/top_cover.stl"
              meshscale="1 1 1" /> <!-- m to mm -->

  <xacro:mesh_link_body name="BottomHatch"
              origin_rpy="0 0 0" origin_xyz="0 0 0"
