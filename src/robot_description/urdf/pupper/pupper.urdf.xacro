              meshscale="1 1 1" /> <!-- m to mm -->
              
  <xacro:frame_joint name="f_l_wheel_servo_rudder" type="fixed"
                  origin_rpy="0 0 0" origin_xyz="0 0 0"
                  parent="front_left_wheel_Servo" child="front_left_wheel_rudder"/>
                  
  <xacro:mesh_link name="front_left_wheel"
              origin_rpy="0 0 0" origin_xyz="-0.109989 -0.086213 0.196043"
              i_rpy="0 0 0" i_xyz="0 0.012482 0"
              mass="0.05"
              c_xyz="${-0.247} ${-0.068} ${0.18}"
              length="0.069"
              width="0.0253"
              height="0.069"
              matname="orange"
              meshfile="file://$(find robot_description)/meshes/pupper/leg/front_left/front_left_wheel_frame.stl"
              meshscale="1 1 1" /> <!-- m to mm -->
  
  <xacro:con_joint name="motor_front_left_wheel" type="continuous"
                    axis_xyz="0 1 0"
                    origin_rpy="0 0 0" origin_xyz="0.001899 0.01308 -0.11921"
                    parent="front_left_wheel_rudder" child="front_left_wheel"
                    effort="3.0" velocity="4.0"
                    damping="${wheel_damping_value}"
                    friction="${wheel_friction_value}"/> 
    
  <xacro:mesh_link_sphere name="front_left_tire"
              origin_rpy="0 0 0" origin_xyz="-0.109989 -0.086213 0.196043"
              i_rpy="0 0 0" i_xyz="0 0.012311 0"
              mass="0.005"
              c_xyz="${-0.247} ${-0.068} ${0.18}"
              length="0.0822"
              width="0.015"
              height="0.0822"
